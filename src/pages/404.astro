---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden – 404" description="Die angeforderte Seite konnte nicht gefunden werden." noindex={true}>
  <section class="section min-h-[60vh] flex items-center justify-center">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <div class="glass-card p-12">
          <!-- 404 Illustration -->
          <div class="text-8xl mb-6">🌿</div>

          <h1 class="text-6xl font-bold text-primary-700 mb-4">404</h1>

          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            Seite nicht gefunden
          </h2>

          <p class="text-lg text-gray-600 mb-8 leading-relaxed">
            Die von Ihnen gesuchte Seite existiert nicht oder wurde verschoben.
            Nutzen Sie die Navigation, um zur gewünschten Seite zu gelangen.
          </p>

          <!-- Navigation Links -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/" class="btn-primary">
              <svg class="w-5 h-5 mr-2 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Zur Startseite
            </a>

            <a href="/kontakt" class="btn-secondary">
              Kontakt aufnehmen
            </a>
          </div>

          <!-- Quick Links -->
          <div class="mt-12 pt-8 border-t border-gray-200">
            <p class="text-sm font-semibold text-gray-600 mb-4">Schnelllinks:</p>
            <div class="flex flex-wrap gap-3 justify-center">
              <a href="/leistungen" class="text-sm text-primary-700 hover:text-primary-900 underline transition-colors">
                Leistungen
              </a>
              <span class="text-gray-400">•</span>
              <a href="/ueber-uns" class="text-sm text-primary-700 hover:text-primary-900 underline transition-colors">
                Über uns
              </a>
              <span class="text-gray-400">•</span>
              <a href="/referenzen" class="text-sm text-primary-700 hover:text-primary-900 underline transition-colors">
                Referenzen
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
