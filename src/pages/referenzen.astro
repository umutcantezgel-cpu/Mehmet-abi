---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Moderne Terrassenanlage in Werdorf',
    category: 'Pflasterarbeiten',
    description: 'Großzügige Terrasse mit Natursteinpflaster und integrierter Beleuchtung.',
    image: '🏡',
  },
  {
    title: 'Natursteinmauer in Aßlar',
    category: 'Mauerbau',
    description: 'Trockenmauer aus heimischem Naturstein als Hangsicherung und Gestaltungselement.',
    image: '🧱',
  },
  {
    title: 'Gartenteich mit Bachlauf in Wetzlar',
    category: 'Teichbau',
    description: 'Natürlicher Gartenteich mit Bachlauf und naturnaher Bepflanzung.',
    image: '💧',
  },
  {
    title: 'Komplette Gartenanlage in Herborn',
    category: 'Gartengestaltung',
    description: 'Neuanlage eines Gartens mit Rasenflächen, Beeten und Sitzplatz.',
    image: '🌿',
  },
  {
    title: 'Einfahrt mit Pflaster in Gießen',
    category: 'Pflasterarbeiten',
    description: 'Einfahrt und Stellplätze mit hochwertigem Betonpflaster.',
    image: '🚗',
  },
  {
    title: 'Hochbeete und Gemüsegarten',
    category: 'Gartengestaltung',
    description: 'Drei Hochbeete aus Naturstein für den privaten Gemüsegarten.',
    image: '🌱',
  },
];
---

<BaseLayout
  title="Referenzen & Projekte – Memo-BauT Gartenbau"
  description="Überzeugen Sie sich von unseren realisierten Projekten: Terrassen, Natursteinmauern, Gartenanlagen in Werdorf, Wetzlar und Umgebung."
>
  <!-- Hero Section -->
  <section class="relative min-h-[40vh] flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
    <div class="container-custom text-center">
      <h1 class="text-white mb-6 drop-shadow-lg">Unsere Referenzen</h1>
      <p class="text-xl text-primary-100 max-w-2xl mx-auto">
        Erfolgreiche Projekte in Werdorf, Wetzlar und Umgebung
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="section">
    <div class="container-custom">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-gradient mb-6">Unsere Projekte</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Beispiele unserer Arbeit – von der Gartengestaltung bis zum Mauerbau
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project, index) => (
          <div class="card-gradient animate-on-scroll" style={`animation-delay: ${index * 100}ms`}>
            <!-- Project Image Placeholder -->
            <div class="aspect-[4/3] bg-gradient-to-br from-primary-400 to-primary-700 rounded-2xl flex items-center justify-center text-white text-6xl mb-6">
              {project.image}
            </div>

            <!-- Project Info -->
            <div class="mb-3">
              <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-semibold rounded-full">
                {project.category}
              </span>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-3">
              {project.title}
            </h3>

            <p class="text-gray-600 leading-relaxed">
              {project.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section bg-gradient-to-b from-transparent to-primary-50/30">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-gradient mb-6">Kundenstimmen</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Was unsere Kunden über uns sagen
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          {
            name: 'Familie Schmidt',
            location: 'Werdorf',
            text: 'Professionelle Beratung und saubere Ausführung. Unsere neue Terrasse ist ein Traum! Sehr zu empfehlen.',
            rating: 5,
          },
          {
            name: 'Michael Weber',
            location: 'Aßlar',
            text: 'Termintreu, fair und qualitativ hervorragend. Die Natursteinmauer ist ein echter Hingucker geworden.',
            rating: 5,
          },
          {
            name: 'Sabine Müller',
            location: 'Wetzlar',
            text: 'Von der Planung bis zur Umsetzung alles perfekt. Unser Gartenteich ist wunderschön geworden!',
            rating: 5,
          },
        ].map((testimonial, index) => (
          <div class="glass-card animate-on-scroll" style={`animation-delay: ${index * 150}ms`}>
            <!-- Rating Stars -->
            <div class="flex gap-1 mb-4">
              {[...Array(testimonial.rating)].map(() => (
                <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                </svg>
              ))}
            </div>

            <p class="text-gray-700 leading-relaxed mb-6 italic">
              "{testimonial.text}"
            </p>

            <div class="pt-4 border-t border-gray-200">
              <p class="font-semibold text-gray-900">{testimonial.name}</p>
              <p class="text-sm text-gray-600">{testimonial.location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section">
    <div class="container-custom">
      <div class="glass-card p-12 text-center max-w-3xl mx-auto">
        <h2 class="text-gradient mb-6">Ihr Projekt – unsere Expertise</h2>
        <p class="text-lg text-gray-600 mb-8">
          Lassen Sie uns gemeinsam Ihr nächstes Projekt realisieren.
          Kostenlose Beratung und unverbindliches Angebot.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/kontakt" class="btn-primary">
            Projekt anfragen
          </a>
          <a href="/leistungen" class="btn-secondary">
            Unsere Leistungen
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
