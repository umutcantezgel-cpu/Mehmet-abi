---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt – Jetzt Projekt anfragen"
  description="Kostenlose Erstberatung für Ihr Gartenprojekt. Telefon: 0176 70162293, E-Mail: info@memobaut.de. Einsatzgebiet: 30km um Werdorf."
>
  <!-- Hero Section -->
  <section class="relative min-h-[40vh] flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
    <div class="container-custom text-center">
      <h1 class="text-white mb-6 drop-shadow-lg">Kontakt</h1>
      <p class="text-xl text-primary-100 max-w-2xl mx-auto">
        Wir freuen uns auf Ihre Anfrage
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div class="animate-on-scroll">
          <div class="glass-card">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Anfrage senden</h2>

            <form
              name="contact"
              method="POST"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              class="space-y-6"
            >
              <input type="hidden" name="form-name" value="contact" />

              <!-- Honeypot -->
              <div class="hidden">
                <label>
                  Don't fill this out: <input name="bot-field" />
                </label>
              </div>

              <!-- Name -->
              <div>
                <label for="name" class="block text-sm font-semibold text-gray-900 mb-2">
                  Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition-all outline-none"
                  placeholder="Ihr Name"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
                  E-Mail *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition-all outline-none"
                  placeholder="ihre@email.de"
                />
              </div>

              <!-- Phone -->
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-900 mb-2">
                  Telefon
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition-all outline-none"
                  placeholder="+49 ..."
                />
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-semibold text-gray-900 mb-2">
                  Ihre Nachricht *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="6"
                  class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition-all outline-none resize-none"
                  placeholder="Beschreiben Sie Ihr Projekt..."
                ></textarea>
              </div>

              <!-- Privacy Checkbox -->
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="privacy"
                  name="privacy"
                  required
                  class="mt-1 w-5 h-5 text-primary-600 border-gray-300 rounded focus:ring-4 focus:ring-primary-100"
                />
                <label for="privacy" class="text-sm text-gray-700">
                  Ich habe die
                  <a href="/datenschutz" class="text-primary-700 underline hover:text-primary-900">
                    Datenschutzerklärung
                  </a>
                  zur Kenntnis genommen. *
                </label>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="btn-primary w-full text-lg">
                Nachricht senden
                <svg class="w-5 h-5 ml-2 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </button>
            </form>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8 animate-on-scroll">
          <!-- Direct Contact -->
          <div class="glass-card">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Direkter Kontakt</h2>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-600 mb-1">Telefon</p>
                  <a href="tel:+4917670162293" class="text-lg font-bold text-primary-700 hover:text-primary-900 focus-ring rounded transition-colors">
                    +49 176 70162293
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-600 mb-1">E-Mail</p>
                  <a href="mailto:info@memobaut.de" class="text-lg font-bold text-primary-700 hover:text-primary-900 focus-ring rounded transition-colors">
                    info@memobaut.de
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-600 mb-1">Adresse</p>
                  <p class="text-gray-900 font-medium">Memo - BauT</p>
                  <p class="text-gray-900">Inh. Mehmet Tezgel</p>
                  <p class="text-gray-900">Falkenstraße 9</p>
                  <p class="text-gray-900">35614 Werdorf</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-600 mb-1">Öffnungszeiten</p>
                  <p class="text-gray-900">Mo–Fr: 09:00–18:00 Uhr</p>
                  <p class="text-gray-900">Sa: 09:00–16:00 Uhr</p>
                  <p class="text-gray-600 text-sm mt-1">Termine nach Vereinbarung</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Service Area -->
          <div class="glass-card">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Unser Einsatzgebiet</h3>
            <p class="text-gray-700 mb-4">
              Wir sind im Umkreis von 30 km um Werdorf für Sie tätig:
            </p>
            <div class="flex flex-wrap gap-2">
              {['Werdorf', 'Aßlar', 'Wetzlar', 'Herborn', 'Gießen', 'Dillenburg', 'Solms'].map((city) => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 text-sm font-medium rounded-full">
                  {city}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="section bg-gradient-to-b from-transparent to-primary-50/30">
    <div class="container-custom">
      <div class="glass-card overflow-hidden">
        <div id="map-container" data-consent-required="maps">
          <div class="aspect-[16/9] bg-gray-200 flex items-center justify-center text-gray-600">
            <div class="text-center p-8">
              <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <h3 class="text-lg font-bold mb-2">Google Maps</h3>
              <p class="text-sm mb-4">Zum Anzeigen der Karte ist Ihre Zustimmung erforderlich.</p>
              <button id="enable-maps" class="btn-secondary">
                Karte laden
              </button>
            </div>
          </div>
          <iframe
            data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2542.5!2d8.4931!3d50.5865!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTDCsDM1JzExLjQiTiA4wrAyOSczNS4yIkU!5e0!3m2!1sde!2sde!4v1234567890"
            width="600"
            height="450"
            style="border:0; width: 100%; height: 100%; display: none;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Standort Memo-BauT auf Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Enable Google Maps when user clicks
    const enableMapsBtn = document.getElementById('enable-maps');
    const mapContainer = document.getElementById('map-container');

    if (enableMapsBtn && mapContainer) {
      enableMapsBtn.addEventListener('click', () => {
        const iframe = mapContainer.querySelector('iframe');
        if (iframe) {
          const src = iframe.getAttribute('data-src');
          if (src) {
            iframe.setAttribute('src', src);
            iframe.style.display = 'block';
            enableMapsBtn.parentElement?.parentElement?.remove();
          }
        }
      });
    }
  </script>
</BaseLayout>
