---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = `https://www.memobaut.de${Astro.url.pathname}`,
  ogType = 'website',
  ogImage = 'https://www.memobaut.de/assets/og-image.jpg',
  noindex = false,
} = Astro.props;

const siteName = 'Memo-BauT Garten- und Landschaftsbau';
const fullTitle = title.includes('Memo-BauT') ? title : `${title} | ${siteName}`;

// Company data for Schema.org
const companyData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.memobaut.de/#organization',
  name: 'Memo - BauT',
  legalName: 'Memo - BauT, Inh. Mehmet Tezgel',
  url: 'https://www.memobaut.de',
  logo: {
    '@type': 'ImageObject',
    url: 'https://www.memobaut.de/assets/logo.svg',
  },
  image: ogImage,
  description: description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Falkenstraße 9',
    postalCode: '35614',
    addressLocality: 'Werdorf',
    addressRegion: 'Hessen',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '50.5865',
    longitude: '8.4931',
  },
  telephone: '+49 176 70162293',
  email: 'info@memobaut.de',
  priceRange: '€€',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '16:00',
    },
  ],
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: '50.5865',
      longitude: '8.4931',
    },
    geoRadius: '30000',
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2e7d46" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(companyData)} />

    <!-- Performance Optimizations -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to Content (Accessibility) -->
    <a href="#main-content" class="skip-link focus-ring">
      Zum Hauptinhalt springen
    </a>

    <!-- Navigation -->
    <header class="fixed top-0 left-0 right-0 z-40 no-print">
      <nav
        class="container-custom py-4 md:py-6"
        role="navigation"
        aria-label="Hauptnavigation"
      >
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <a
            href="/"
            class="text-2xl font-bold text-primary-700 hover:text-primary-900 focus-ring rounded-lg transition-colors"
            aria-label="Zurück zur Startseite"
          >
            <span class="text-gradient">Memo-BauT</span>
          </a>

          <!-- Desktop Navigation -->
          <ul class="hidden md:flex items-center gap-2 glass-nav">
            <li>
              <a
                href="/leistungen"
                class="px-4 py-2 rounded-full text-gray-700 hover:text-primary-700 hover:bg-white/50 focus-ring transition-all"
              >
                Leistungen
              </a>
            </li>
            <li>
              <a
                href="/ueber-uns"
                class="px-4 py-2 rounded-full text-gray-700 hover:text-primary-700 hover:bg-white/50 focus-ring transition-all"
              >
                Über uns
              </a>
            </li>
            <li>
              <a
                href="/referenzen"
                class="px-4 py-2 rounded-full text-gray-700 hover:text-primary-700 hover:bg-white/50 focus-ring transition-all"
              >
                Referenzen
              </a>
            </li>
            <li>
              <a
                href="/kontakt"
                class="btn-primary ml-4"
                aria-label="Kontaktieren Sie uns"
              >
                Kontakt
              </a>
            </li>
          </ul>

          <!-- Mobile Menu Button with Icon Morphing -->
          <button
            id="mobile-menu-btn"
            class="md:hidden glass-nav focus-ring relative w-12 h-12 flex items-center justify-center"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <div class="hamburger-icon">
              <span class="line line-1"></span>
              <span class="line line-2"></span>
              <span class="line line-3"></span>
            </div>
          </button>
        </div>

        <!-- Premium Mobile Menu with Slide-In -->
        <div
          id="mobile-menu"
          class="mobile-menu fixed inset-0 z-50 md:hidden pointer-events-none"
          aria-hidden="true"
          role="menu"
        >
          <!-- Backdrop -->
          <div class="mobile-menu-backdrop absolute inset-0 bg-gray-900/50 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

          <!-- Slide-in Panel -->
          <div class="mobile-menu-panel absolute top-0 right-0 h-full w-80 max-w-[85vw] glass-overlay shadow-2xl transform translate-x-full transition-transform duration-400">
            <div class="p-6 h-full flex flex-col">
              <!-- Close Button -->
              <button
                id="mobile-menu-close"
                class="self-end glass-subtle rounded-full p-3 mb-6 focus-ring hover:bg-white/50 transition-all"
                aria-label="Menü schließen"
              >
                <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>

              <!-- Menu Links with Stagger Animation -->
              <ul class="mobile-menu-links space-y-2 flex-1">
                <li style="--delay: 0.1s;">
                  <a
                    href="/leistungen"
                    class="block px-6 py-4 rounded-xl text-gray-700 hover:bg-primary-50 hover:text-primary-900 focus-ring transition-all text-lg font-semibold"
                    role="menuitem"
                  >
                    Leistungen
                  </a>
                </li>
                <li style="--delay: 0.15s;">
                  <a
                    href="/ueber-uns"
                    class="block px-6 py-4 rounded-xl text-gray-700 hover:bg-primary-50 hover:text-primary-900 focus-ring transition-all text-lg font-semibold"
                    role="menuitem"
                  >
                    Über uns
                  </a>
                </li>
                <li style="--delay: 0.2s;">
                  <a
                    href="/referenzen"
                    class="block px-6 py-4 rounded-xl text-gray-700 hover:bg-primary-50 hover:text-primary-900 focus-ring transition-all text-lg font-semibold"
                    role="menuitem"
                  >
                    Referenzen
                  </a>
                </li>
                <li style="--delay: 0.25s;">
                  <a
                    href="/kontakt"
                    class="block btn-primary btn-lg w-full text-center mt-4"
                    role="menuitem"
                  >
                    Kontakt
                  </a>
                </li>
              </ul>

              <!-- Contact Info in Menu -->
              <div class="mt-auto pt-6 border-t border-gray-200" style="--delay: 0.3s;">
                <p class="text-sm text-gray-600 mb-2">Rufen Sie uns an:</p>
                <a href="tel:+4917670162293" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors">
                  +49 176 70162293
                </a>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 pt-24 md:pt-32">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gradient-to-b from-transparent to-primary-950 text-white mt-16 no-print">
      <div class="container-custom py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
          <!-- Company Info -->
          <div>
            <h2 class="text-2xl font-bold mb-4 text-gradient-white">Memo-BauT</h2>
            <p class="text-primary-100 mb-4">
              Ihr Partner für professionellen Garten- und Landschaftsbau in Mittelhessen.
            </p>
            <p class="text-sm text-primary-200">Seit 2003</p>
          </div>

          <!-- Contact -->
          <div>
            <h3 class="text-lg font-semibold mb-4">Kontakt</h3>
            <ul class="space-y-2 text-primary-100">
              <li>
                <a
                  href="tel:+4917670162293"
                  class="hover:text-white focus-ring rounded transition-colors"
                >
                  +49 176 70162293
                </a>
              </li>
              <li>
                <a
                  href="mailto:info@memobaut.de"
                  class="hover:text-white focus-ring rounded transition-colors"
                >
                  info@memobaut.de
                </a>
              </li>
              <li class="pt-2">
                Falkenstraße 9<br />
                35614 Werdorf
              </li>
            </ul>
          </div>

          <!-- Links -->
          <div>
            <h3 class="text-lg font-semibold mb-4">Rechtliches</h3>
            <ul class="space-y-2">
              <li>
                <a
                  href="/impressum"
                  class="text-primary-100 hover:text-white focus-ring rounded transition-colors"
                >
                  Impressum
                </a>
              </li>
              <li>
                <a
                  href="/datenschutz"
                  class="text-primary-100 hover:text-white focus-ring rounded transition-colors"
                >
                  Datenschutz
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-8 border-t border-primary-800 text-center text-primary-200 text-sm">
          <p>© {new Date().getFullYear()} Memo-BauT. Alle Rechte vorbehalten.</p>
        </div>
      </div>
    </footer>

    <!-- Premium Mobile Menu Script -->
    <script>
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuClose = document.getElementById('mobile-menu-close');
      const mobileMenuBackdrop = mobileMenu?.querySelector('.mobile-menu-backdrop');

      function openMobileMenu() {
        if (mobileMenuBtn && mobileMenu) {
          mobileMenuBtn.setAttribute('aria-expanded', 'true');
          mobileMenuBtn.setAttribute('aria-label', 'Menü schließen');
          mobileMenu.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden'; // Prevent background scroll
        }
      }

      function closeMobileMenu() {
        if (mobileMenuBtn && mobileMenu) {
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
          mobileMenuBtn.setAttribute('aria-label', 'Menü öffnen');
          mobileMenu.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = ''; // Restore scroll
        }
      }

      // Open menu
      if (mobileMenuBtn) {
        mobileMenuBtn.addEventListener('click', () => {
          const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });
      }

      // Close menu via close button
      if (mobileMenuClose) {
        mobileMenuClose.addEventListener('click', closeMobileMenu);
      }

      // Close menu when clicking backdrop
      if (mobileMenuBackdrop) {
        mobileMenuBackdrop.addEventListener('click', closeMobileMenu);
      }

      // Close menu when clicking a link
      const menuLinks = mobileMenu?.querySelectorAll('a');
      menuLinks?.forEach(link => {
        link.addEventListener('click', closeMobileMenu);
      });

      // Close menu on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu?.getAttribute('aria-hidden') === 'false') {
          closeMobileMenu();
        }
      });
    </script>

    <!-- Additional Scripts -->
    <script>
      // Scroll to top on page load (for accessibility)
      window.addEventListener('load', () => {
        window.scrollTo(0, 0);
      });

      // Intersection Observer for scroll animations
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          { threshold: 0.1 }
        );

        document.querySelectorAll('.animate-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
