---
interface Props {
  title: string;
  description: string;
  icon?: string;
  link?: string;
}

const { title, description, icon, link } = Astro.props;
---

<div class="group card-gradient hover-lift h-full">
  <div class="flex flex-col h-full">
    {icon && (
      <div class="mb-6">
        <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-700 rounded-2xl flex items-center justify-center text-white text-3xl shadow-smooth group-hover:scale-110 transition-transform duration-300">
          {icon}
        </div>
      </div>
    )}

    <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-primary-700 transition-colors">
      {title}
    </h3>

    <p class="text-gray-600 leading-relaxed mb-6 flex-1">
      {description}
    </p>

    {link && (
      <a
        href={link}
        class="inline-flex items-center text-primary-700 font-semibold hover:text-primary-900 focus-ring rounded transition-colors"
        aria-label={`Mehr über ${title} erfahren`}
      >
        Mehr erfahren
        <svg
          class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"
          />
        </svg>
      </a>
    )}
  </div>
</div>
